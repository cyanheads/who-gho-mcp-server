{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "who-gho-mcp-server",
  "version": "0.3.4",
  "description": "Query WHO Global Health Observatory data — 3,059 indicators across 194 member states with country, region, year, and sex filters via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/who-gho-mcp-server#readme",
  "repository": "https://github.com/cyanheads/who-gho-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "who", "global-health", "health-data"],
  "mcpServers": {
    "who-gho-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/who-gho-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
